// .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Create Snapshot",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npx",
        "runtimeArgs": [
          "tsx", "src/cli.ts",
          "snapshot", "--target-directory", "testDir"
        ],
        "skipFiles": ["<node_internals>/**"],
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "Create List",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npx",
        "runtimeArgs": [
          "tsx", "src/cli.ts",
          "list"
        ],
        "skipFiles": ["<node_internals>/**"],
        "cwd": "${workspaceFolder}"
      }
    ]
  }
  